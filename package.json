{
  "name": "to_do_list",
  "productName": "To Do List",
  "version": "1.0.0",
  "description": "Desktop to-do list with quick add and reminder notifications.",
  "main": ".webpack/main",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "start:dev": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"Remove-Item Env:TODO_PROFILE -ErrorAction SilentlyContinue; $env:TODO_APP_VARIANT='dev'; $env:TODO_WEBPACK_PORT='3000'; $env:TODO_WEBPACK_LOGGER_PORT='9000'; npm run start\"",
    "start:user": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:TODO_PROFILE='user'; $env:TODO_APP_VARIANT='user'; $env:TODO_WEBPACK_PORT='3001'; $env:TODO_WEBPACK_LOGGER_PORT='9001'; npm run start\"",
    "start:me": "npm run start:dev",
    "start:friend": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:TODO_PROFILE='friend'; $env:TODO_APP_VARIANT='user'; $env:TODO_WEBPACK_PORT='3002'; $env:TODO_WEBPACK_LOGGER_PORT='9002'; npm run start\"",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "make:dev": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:TODO_APP_VARIANT='dev'; npm run make\"",
    "make:user": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:TODO_APP_VARIANT='user'; npm run make\"",
    "publish": "electron-forge publish",
    "lint": "eslint --ext .ts,.tsx ."
  },
  "keywords": [],
  "author": {
    "name": "arkave",
    "email": "get2arkan@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron-forge/plugin-webpack": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "@types/node": "^16.11.7",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vercel/webpack-asset-relocator-loader": "^1.7.3",
    "css-loader": "^6.11.0",
    "electron": "41.2.1",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "fork-ts-checker-webpack-plugin": "^7.3.0",
    "node-loader": "^2.1.0",
    "style-loader": "^3.3.4",
    "ts-loader": "^9.5.7",
    "typescript": "~4.5.4"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.104.0",
    "dotenv": "^17.4.2",
    "electron-squirrel-startup": "^1.0.1",
    "electron-store": "^11.0.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  }
}
